#: ../../infrastructure/clusters/hvm/architecture.rst:153
msgid "Description"
msgstr "Descripción"

#: ../../infrastructure/clusters/hvm/architecture.rst:94
msgid "Quorum Achieved"
msgstr "Quorum Achieved"

#: ../../infrastructure/clusters/hvm/architecture.rst:95
msgid "A majority of cluster nodes are reachable. Normal operations continue."
msgstr "Un majority de cluster nodos son reachable. Normal operaciones continuar."

#: ../../infrastructure/clusters/hvm/architecture.rst:96
msgid "Quorum Lost"
msgstr "Quorum Lost"

#: ../../infrastructure/clusters/hvm/architecture.rst:97
msgid ""
"The node cannot reach a majority of peers. The node self-fences to "
"protect data integrity."
msgstr ""
"El nodo cannot reach un majority de peers. El nodo self-fences a protect "
"datos integrity."

#: ../../infrastructure/clusters/hvm/architecture.rst:98
msgid "Fenced"
msgstr "Fenced"

#: ../../infrastructure/clusters/hvm/architecture.rst:99
msgid "The node has been fenced and is waiting for recovery."
msgstr "El nodo tiene been fenced y es waiting para recuperación."

#: ../../infrastructure/clusters/hvm/architecture.rst:102
msgid "Designated Coordinator"
msgstr "Designated Coordinator"

#: ../../infrastructure/clusters/hvm/architecture.rst:104
msgid ""
"The cluster elects a Designated Coordinator from among the reachable "
"nodes. The coordinator is determined by the lowest hash of reachable host"
" key hashes (sorted alphabetically). Only the coordinator is authorized "
"to issue fencing operations."
msgstr ""
"El cluster elects un Designated Coordinator desde among el reachable "
"nodos. El coordinator es determined por el lowest hash de reachable host "
"clave hashes (sorted alphabetically). Solo el coordinator es authorized a"
" problema fencing operaciones."

#: ../../infrastructure/clusters/hvm/architecture.rst:107
msgid "Heartbeat Failover (MvmHeartbeatFailover)"
msgstr "Heartbeat Failover (MvmHeartbeatFailover)"

#: ../../infrastructure/clusters/hvm/architecture.rst:109
msgid ""
"The heartbeat failover mechanism monitors host health via shared storage "
"and orchestrates VM recovery when a host fails."
msgstr ""
"El heartbeat conmutación por error mechanism monitors host health via "
"shared storage y orchestrates VM recuperación cuando un host falla."

#: ../../infrastructure/clusters/hvm/architecture.rst:112
msgid "Heartbeat Writes"
msgstr "Heartbeat Writes"

#: ../../infrastructure/clusters/hvm/architecture.rst:114
msgid "Each host writes ``hb.properties`` to shared storage every 20 seconds"
msgstr "Cada host writes ``hb.properties`` a shared storage cada 20 seconds"

#: ../../infrastructure/clusters/hvm/architecture.rst:115
msgid "The heartbeat file contains hostname, memory statistics, and timestamp"
msgstr "El heartbeat archivo contiene hostname, memoria statistics, y timestamp"

#: ../../infrastructure/clusters/hvm/architecture.rst:116
msgid "VM XML definitions are written for all running VMs alongside the heartbeat"
msgstr ""
"VM XML definitions son written para todos ejecutando VMs alongside el "
"heartbeat"

#: ../../infrastructure/clusters/hvm/architecture.rst:119
msgid "Failure Detection"
msgstr "Fallo Detection"

#: ../../infrastructure/clusters/hvm/architecture.rst:121
msgid ""
"A host is considered offline after 140 seconds (7 missed heartbeat "
"intervals)"
msgstr ""
"Un host es considered offline después de 140 seconds (7 missed heartbeat "
"intervals)"

#: ../../infrastructure/clusters/hvm/architecture.rst:122
msgid ""
"The Designated Coordinator assigns the failed host's VMs to surviving "
"hosts based on available memory"
msgstr ""
"El Designated Coordinator asigna el falló host's VMs a surviving hosts "
"basado en disponible memoria"

#: ../../infrastructure/clusters/hvm/architecture.rst:125
msgid "Storage Structure"
msgstr "Storage Structure"

#: ../../infrastructure/clusters/hvm/architecture.rst:127
msgid "Heartbeat data is stored on the HPE Clustered Datastore (Shared LUN) at:"
msgstr ""
"Heartbeat datos es stored en el HPE Clustered Almacén de datos (Shared "
"LUN) en:"

#: ../../infrastructure/clusters/hvm/architecture.rst:129
msgid ""
"<datastore>/mvm-hb/<cluster_uuid>-2/<host_hash>/\n"
"  ├── hb.properties\n"
"  ├── *.xml          (VM definitions)\n"
"  └── recover/"
msgstr ""
"<datastore>/mvm-hb/<cluster_uuid>-2/<host_hash>/\n"
"  ├── hb.properties\n"
"  ├── *.xml          (VM definitions)\n"
"  └── recover/"

#: ../../infrastructure/clusters/hvm/architecture.rst:137
msgid "APD (All Paths Down) Protection"
msgstr "APD (Todos Paths Down) Protection"

#: ../../infrastructure/clusters/hvm/architecture.rst:139
msgid ""
"APD protection prevents split-brain data corruption when a host loses "
"access to shared storage."
msgstr ""
"APD protection prevents split-brain datos corruption cuando un host loses"
" acceso a shared storage."

#: ../../infrastructure/clusters/hvm/architecture.rst:141
msgid ""
"After 6 consecutive failed heartbeat writes (~2 minutes), all non-pinned "
"VMs on shared storage are shut down"
msgstr ""
"Después de 6 consecutive falló heartbeat writes (~2 minutes), todos non-"
"pinned VMs en shared storage son shut down"

#: ../../infrastructure/clusters/hvm/architecture.rst:142
msgid ""
"This prevents VMs from running with stale data while another host may be "
"serving the same storage"
msgstr ""
"Este prevents VMs desde ejecutando con stale datos mientras another host "
"puede be serving el mismo storage"

